{
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-console": "off",
    "linebreak-style": ["error", "windows"],
    "no-unused-vars": ["warn"],
    "quotes": ["error", "single"],
    "comma-dangle": ["error", "always-multiline"]
  }
}